# 复制为 deploy/.env 后修改，不要提交 .env
# cp .env.example .env
#
# 两个 Compose 项目（与 blog-app-images.tar 中镜像名一致）：
#   docker-compose.infra.yml      → 项目 blog-infra：PostgreSQL + Redis，创建网络 blog-network
#   docker-compose.app.yml        → 项目 blog-app：服务器上 build 前后端
#   docker-compose.app.images.yml   → 项目 blog-app：已 docker load 的镜像
# 首次：先 infra up，再 app / app.images up。
# 升级只动业务：docker compose -f docker-compose.app.images.yml --env-file .env up -d

DB_NAME=blog
DB_USERNAME=postgres
DB_PASSWORD=请改为强密码

REDIS_PASSWORD=请改为强密码

# 中间件映射到宿主机端口（供本机客户端或宿主机进程连接；与容器内 blog-db:5432 / blog-redis:6379 无关）
# DB_HOST_PORT=5432
# REDIS_HOST_PORT=6379

JWT_SECRET=请改为至少32字节的随机串

# 腾讯云 COS（与 application.yml 一致）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=
COS_URL_PREFIX=

# 首次在空库上部署可保留 update；表结构稳定后建议改为 validate
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# 宿主机映射端口（默认 80）
HTTP_PORT=80
# 启用 HTTPS 时（docker-compose.app.https.yml）映射 443
HTTPS_PORT=443

# MiniMax（管理端 AI，可选）
# SPRING_AI_MODEL_CHAT=minimax
# MINIMAX_API_KEY=sk-cp-hVyyRfWIqAHBQhyZdLUcloCIVvQmfdh1HzOIkQy2swF08QXLDMozfHNl1WKnAmW-LBV62DQDfYfSfp-ZWvyji9lerZspmR5QORyrAQ1dvCGGXSpRvMRd1nM
# 官方默认 https://api.minimax.chat；换线路/代理时覆盖
# MINIMAX_BASE_URL=https://api.minimax.chat
# MINIMAX_MODEL=MiniMax-M2.7
# 文生图封面（与 Chat 不同接口，默认 https://api.minimaxi.com/v1/image_generation）
# MINIMAX_IMAGE_URL=https://api.minimaxi.com/v1/image_generation
# MINIMAX_IMAGE_MODEL=image-01
# 默认 base64；若只要 URL 模式可设为 url
# MINIMAX_IMAGE_RESPONSE_FORMAT=base64
# MINIMAX_IMAGE_N=1
# MINIMAX_IMAGE_PROMPT_OPTIMIZER=true
# 封面专用 HTTP 超时（毫秒），读超时到点会失败返回
# AI_COVER_HTTP_CONNECT_TIMEOUT_MS=10000
# AI_COVER_HTTP_READ_TIMEOUT_MS=90000
# 出图尺寸：默认 1280×720（16:9）；仅 aspect_ratio 时设 width=0 height=0
# MINIMAX_IMAGE_WIDTH=1280
# MINIMAX_IMAGE_HEIGHT=720
# 闪电图床 API：https://www.boltp.com/pages/api-docs 用户中心生成 Token
# BOLTP_UPLOAD_URL=https://www.boltp.com/api/v2/upload
# BOLTP_TOKEN=1044|MZAjp0TOqEcHLxMPsoHtSUZXYHOoWkJCpKHGYkwU11cf5bba
# BOLTP_STORAGE_ID=2
# BOLTP_ALBUM_ID=282
# 若图床要求表单 token 而非 Bearer：BOLTP_AUTH_MODE=form-token
